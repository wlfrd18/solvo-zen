# Copiez ce fichier en ".env" dans backend/ pour un developpement local
# sans Docker. Ne committez jamais le fichier ".env" reel.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Paris
CORS_ALLOWED_ORIGINS=http://localhost:3000
PROJECTION_DEFAULT_HORIZON_DAYS=35

# Optionnel : sans DATABASE_URL, le backend utilise SQLite (db.sqlite3).
# DATABASE_URL=postgres://solvo:change-me@localhost:5432/solvo
