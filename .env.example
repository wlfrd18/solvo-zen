# Copiez ce fichier en ".env" a la racine du projet avant de lancer
# `docker compose up`. Ne committez jamais le fichier ".env" reel.

# --- Postgres ---
POSTGRES_DB=solvo
POSTGRES_USER=solvo
POSTGRES_PASSWORD=change-me

# --- Django (backend) ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_TIME_ZONE=Europe/Paris
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://solvo:change-me@db:5432/solvo
PROJECTION_DEFAULT_HORIZON_DAYS=35

# --- Next.js (frontend) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
